# ============================================================================
# VanishChat 环境变量示例
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# ============================================================================

# ---------------------------------------------------------------- 基础
PORT=3000
NODE_ENV=development
# 允许的跨域来源，生产建议收敛为具体域名，例如 https://chat.example.com
CORS_ORIGIN=*

# ---------------------------------------------------------------- 存储
# redis  强制使用 Redis，连不上则启动失败（生产推荐）
# memory 强制纯内存（单进程演示 / 无 Redis 环境）
# auto   先尝试 Redis，失败自动降级为内存（默认）
STORE_DRIVER=auto
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=vc
REDIS_CONNECT_TIMEOUT=1500

# ---------------------------------------------------------------- 会话
TOKEN_LENGTH=8
SESSION_DEFAULT_TTL_HOURS=24
# 前端可选有效期档位（小时，逗号分隔）
SESSION_EXPIRY_TIERS=1,2,6,12,24,72
SESSION_MAX_TTL_HOURS=720
# 单会话人数上限，一对一聊天保持 2
SESSION_MAX_PARTICIPANTS=2
# 单会话消息条数上限，防止内存被无限撑爆
SESSION_MAX_MESSAGES=5000
# 过期清扫间隔，单位毫秒
SESSION_SWEEP_INTERVAL_MS=30000

# ---------------------------------------------------------------- 文件
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_REQUEST=9

# ---------------------------------------------------------------- 日志
LOG_ENABLED=true
# 行为日志保留天数（仅记录行为，不记录消息内容）
LOG_RETENTION_DAYS=30

# ---------------------------------------------------------------- 限流
RATE_CREATE_PER_MINUTE=10
RATE_VERIFY_PER_MINUTE=30

# ---------------------------------------------------------------- 运维
# 设置后可通过 /api/logs 查看行为日志（请求头 x-admin-token）
# ADMIN_TOKEN=please-change-me
# DEBUG=true  # 打开调试日志与 /api/debug/:token
